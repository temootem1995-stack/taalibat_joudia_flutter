rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth!=null;}
  function admin(){return signedIn()&&get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role=='admin';}
  match /users/{uid}{allow read:if signedIn()&&(request.auth.uid==uid||admin());allow create,update:if admin()||request.auth.uid==uid;allow delete:if admin();}
  match /products/{id}{allow read:if signedIn();allow write:if admin();}
  match /orders/{id}{allow read:if signedIn()&&(admin()||resource.data.salesRepId==request.auth.uid);allow create:if signedIn()&&request.resource.data.salesRepId==request.auth.uid;allow update:if signedIn()&&(admin()||resource.data.salesRepId==request.auth.uid);allow delete:if admin();}
 }
}
